{
    "data_location": "../data/online_shoppers_intention.csv",
    "model": "Logistic Regression",
    "mutator": "change_to_zero",
    "num_mutation_checks": 10,
    "mutation_target": ["BounceRates", "ExitRates", "Administrative", "Administrative_Duration", "ProductRelated"],
    "num_scoring_groups": 7,
    "seeds": {
        "outer_seed": 123,
        "inner_seed": 456
    },
    "training_percent": 0.5,
    "noise_arguments": {"distribution": "exponential", "mean": 0, "std": 1, "low": 0, "high": 100, "scale":2}
}
